[Unit]
Description=cloudflared connector for the NeoChip public website (neochip-web-public)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
ExecStart=/usr/local/bin/cloudflared --no-autoupdate --config /etc/cloudflared/web.yml tunnel run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
